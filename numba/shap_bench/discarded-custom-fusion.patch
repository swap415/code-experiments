+def numpy_arrayexpr_sum(context, builder, sig, args, sum_ty, kernel_class):
+    """Reduce integer expression elements without materializing an array."""
+    inputs = [_prepare_argument(context, builder, arg, ty)
+              for arg, ty in zip(args, sig.args)]
+    shape = _broadcast_shape(context, builder, sig.return_type.ndim, inputs)
+    element_ty = sig.return_type.dtype
+    kernel_sig = element_ty(*(arg.base_type for arg in inputs))
+    kernel = kernel_class(context, builder, kernel_sig)
+    indices = [arg.create_iter_indices() for arg in inputs]
+    acc = cgutils.alloca_once_value(builder, context.get_constant(sum_ty, 0))
+    intp = context.get_value_type(types.intp)
+    with cgutils.loop_nest(builder, shape, intp=intp) as loop_indices:
+        values = []
+        for i, (index, arg) in enumerate(zip(indices, inputs)):
+            index.update_indices(loop_indices, i)
+            values.append(arg.load_data(index.as_values()))
+        # The kernel narrows to the expression dtype before sum promotion.
+        value = kernel.generate(*values)
+        value = context.cast(builder, value, element_ty, sum_ty)
+        builder.store(builder.add(builder.load(acc), value), acc)
+    return builder.load(acc)
+
