+@rewrites.register_rewrite('after-inference')
+class RewriteArrayExprSums(rewrites.Rewrite):
+    """Fuse a single-use integer array expression with its scalar sum."""
+
+    def __init__(self, state):
+        self.enabled = not state.flags.auto_parallel.enabled
+        state.targetctx.special_ops['arrayexpr_sum'] = _lower_array_expr
+
+    def match(self, func_ir, block, typemap, calltypes):
+        if not self.enabled:
+            return False
+        assignments = {inst.target.name: inst
+                       for inst in block.find_insts(ir.Assign)}
+        producers = {name: inst for name, inst in assignments.items()
+                     if isinstance(inst.value, ir.Expr)
+                     and inst.value.op == 'arrayexpr'}
+        if not producers:
+            return False
+
+        uses = defaultdict(int)
+        definitions = defaultdict(int)
+        for other in func_ir.blocks.values():
+            for inst in other.body:
+                if isinstance(inst, ir.Del):
+                    continue
+                if isinstance(inst, ir.Assign):
+                    definitions[inst.target.name] += 1
+                    variables = inst._rec_list_vars(inst.value)
+                else:
+                    variables = inst.list_vars()
+                for var in variables:
+                    uses[var.name] += 1
+
+        for reduction in assignments.values():
+            call = reduction.value
+            if (not isinstance(call, ir.Expr) or call.op != 'call'
+                    or call.kws or call.vararg is not None
+                    or call.varkwarg is not None):
+                continue
+            sum_ty = typemap[reduction.target.name]
+            if not isinstance(sum_ty, types.Integer):
+                continue
+            func_ty = typemap.get(call.func.name)
+            method = None
+            if (isinstance(func_ty, types.BoundFunction)
+                    and func_ty.typing_key == 'array.sum' and not call.args):
+                method = assignments.get(call.func.name)
+                if (method is None or not isinstance(method.value, ir.Expr)
+                        or method.value.op != 'getattr'
+                        or method.value.attr != 'sum'
+                        or uses[call.func.name] != 1):
+                    continue
+                array = method.value.value
+            elif (isinstance(func_ty, types.Function)
+                    and func_ty.typing_key is np.sum and len(call.args) == 1):
+                array = call.args[0]
+            else:
+                continue
+            producer = producers.get(array.name)
+            if producer is None or uses[array.name] != 1:
+                continue
+            expr = producer.value
+            if (type(expr.ty) is not types.Array or expr.ty.ndim != 1
+                    or not isinstance(expr.ty.dtype,
+                                      (types.Boolean, types.Integer))
+                    or not self._integer_leaves(expr.expr, typemap)):
+                continue
+            removed = [producer, reduction]
+            if method is not None:
+                removed.append(method)
+            if any(definitions[inst.target.name] != 1 for inst in removed):
+                continue
+            # Reduce at the producer: intervening code may mutate its inputs.
+            fused = ir.Expr('arrayexpr_sum', expr.loc, expr=expr.expr,
+                            ty=expr.ty, sum_ty=sum_ty)
+            self.replacement = ir.Assign(fused, reduction.target, producer.loc)
+            self.producer = producer
+            self.removed = set(removed)
+            self.dead = {inst.target.name for inst in removed
+                         if inst is not reduction}
+            self.block = block
+            return True
+        return False
+
+    def _integer_leaves(self, expr, typemap):
+        if isinstance(expr, tuple):
+            return all(self._integer_leaves(arg, typemap) for arg in expr[1])
+        if isinstance(expr, ir.Const):
+            return isinstance(expr.value, (int, np.integer, np.bool_))
+        if not isinstance(expr, ir.Var):
+            return False
+        ty = typemap[expr.name]
+        if type(ty) is types.Array and ty.ndim == 1:
+            ty = ty.dtype
+        return isinstance(ty, (types.Boolean, types.Integer))
+
+    def apply(self):
+        result = self.block.copy()
+        result.body = [self.replacement if inst is self.producer else inst
+                       for inst in self.block.body
+                       if (inst is self.producer or inst not in self.removed)
+                       and not (isinstance(inst, ir.Del)
+                                and inst.value in self.dead)]
+        return result
+
