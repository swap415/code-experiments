+"""Isolate helper inlining after sum fusion; this is not a compiler change."""
+
+import statistics
+import time
+
+from numba import njit
+import numpy as np
+
+from bench_compiler_fusion import load_kernels
+
+
+def main():
+    variants = {name: load_kernels() for name in ('fused', 'inline_score')}
+    kernels = variants['inline_score']
+    kernels['_mask_delta_score'] = njit(inline='always')(
+        kernels['_mask_delta_score'].py_func)
+    masks = np.random.default_rng(0).integers(0, 2, (8192, 13)).astype(np.bool_)
+    expected = variants['fused']['_delta_minimization_order'](masks)
+    for name, kernels in variants.items():
+        for _ in range(2):
+            np.testing.assert_array_equal(
+                kernels['_delta_minimization_order'](masks), expected)
+        gain = kernels['_reverse_window_score_gain']
+        llvm = gain.inspect_llvm(gain.signatures[0])
+        native = llvm[llvm.index('\ndefine '):].split('\n}\n', 1)[0]
+        references = sum('call void @NRT_' in line
+                         for line in native.splitlines())
+        print(f'{name}: score_gain native NRT calls={references}')
+    timings = {name: [] for name in variants}
+    for repetition in range(10):
+        for name in list(variants)[::(-1 if repetition % 2 else 1)]:
+            start = time.perf_counter_ns()
+            result = variants[name]['_delta_minimization_order'](masks)
+            timings[name].append((time.perf_counter_ns() - start) / 1e6)
+            np.testing.assert_array_equal(result, expected)
+    for name, samples in timings.items():
+        print(f'{name}: mean={statistics.mean(samples):.4f} ms, '
+              f'std={statistics.stdev(samples):.4f} ms, '
+              f'median={statistics.median(samples):.4f} ms, n=10')
+
+
+if __name__ == '__main__':
+    main()
