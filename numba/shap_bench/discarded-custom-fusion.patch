diff --git a/numba/tests/test_array_expr_sum.py b/numba/tests/test_array_expr_sum.py
new file mode 100644
index 000000000..de6f72d73
--- /dev/null
+++ b/numba/tests/test_array_expr_sum.py
@@ -0,0 +1,183 @@
+import unittest
+
+import numpy as np
+
+from numba import njit
+from numba.tests.support import MemoryLeakMixin, TestCase
+
+
+class TestArrayExprSum(MemoryLeakMixin, TestCase):
+    def compile(self, pyfunc):
+        return njit(pyfunc), njit(no_rewrites=True)(pyfunc)
+
+    def check(self, functions, *args):
+        compiled, baseline = functions
+        expected = compiled.py_func(*args)
+        self.assertPreciseEqual(compiled(*args), expected)
+        self.assertPreciseEqual(baseline(*args), expected)
+
+    def assert_allocation(self, compiled, expected):
+        llvm = compiled.inspect_llvm(compiled.signatures[-1])
+        self.assertEqual('NRT_MemInfo_alloc_aligned' in llvm, expected)
+
+    def test_boolean_xor(self):
+        def kernel(a, b):
+            return (a ^ b).sum()
+
+        functions = self.compile(kernel)
+        for size in (0, 1, 13, 257):
+            with self.subTest(size=size):
+                a = np.arange(size) % 2 == 0
+                b = np.arange(size) % 3 == 0
+                self.check(functions, a, b)
+        self.assert_allocation(functions[0], False)
+        self.assert_allocation(functions[1], True)
+
+    def test_other_expressions(self):
+        def global_sum(a, b):
+            return np.sum(a + b)
+
+        def comparison(a, b):
+            return (a < b).sum()
+
+        def nested(a, b):
+            return ((a ^ b) & (a + 1)).sum()
+
+        def scalar(a, b):
+            return (a * 3).sum()
+
+        a = np.arange(17, dtype=np.int64)
+        b = a[::-1].copy()
+        for kernel in (global_sum, comparison, nested, scalar):
+            with self.subTest(kernel=kernel.__name__):
+                functions = self.compile(kernel)
+                self.check(functions, a, b)
+                self.assert_allocation(functions[0], False)
+
+    def test_integer_dtypes(self):
+        def kernel(a, b):
+            return (a + b).sum()
+
+        functions = self.compile(kernel)
+        for dtype in (np.int8, np.uint8, np.int32, np.uint32,
+                      np.int64, np.uint64):
+            with self.subTest(dtype=dtype):
+                a = np.array([np.iinfo(dtype).max, 1], dtype=dtype)
+                b = np.array([1, 2], dtype=dtype)
+                self.check(functions, a, b)
+                self.assert_allocation(functions[0], False)
+                signature = functions[0].signatures[-1]
+                self.assertEqual(
+                    functions[0].overloads[signature].signature.return_type,
+                    functions[1].overloads[signature].signature.return_type,
+                )
+
+    def test_broadcast(self):
+        def kernel(a, b):
+            return (a + b).sum()
+
+        functions = self.compile(kernel)
+        singleton = np.array([7], dtype=np.int64)
+        for size in (0, 1, 13):
+            a = np.arange(size, dtype=np.int64)
+            self.check(functions, a, singleton)
+            self.check(functions, singleton, a)
+        self.assert_allocation(functions[0], False)
+        for sizes in ((2, 3), (0, 2)):
+            args = tuple(np.arange(size) for size in sizes)
+            for kernel in (functions[0].py_func, functions[0]):
+                with self.assertRaises(ValueError):
+                    kernel(*args)
+
+    def test_array_views(self):
+        def kernel(a, b):
+            return (a ^ b).sum()
+
+        functions = self.compile(kernel)
+        a = np.arange(33, dtype=np.int32)
+        for view in (a[::2], a[::-1]):
+            self.check(functions, view, view[::-1])
+            self.assert_allocation(functions[0], False)
+        a.flags.writeable = False
+        self.check(functions, a, a)
+        self.assert_allocation(functions[0], False)
+
+    def test_multiple_uses(self):
+        def escape(a, b):
+            value = a + b
+            return value.sum(), value
+
+        def multiple_consumers(a, b):
+            value = a + b
+            return value.sum() + value[0]
+
+        def shared_method(a, b):
+            reduce = (a + b).sum
+            return reduce(), reduce()
+
+        a = np.arange(5)
+        for kernel in (escape, multiple_consumers, shared_method):
+            with self.subTest(kernel=kernel.__name__):
+                functions = self.compile(kernel)
+                self.check(functions, a, a)
+                self.assert_allocation(functions[0], True)
+
+    def test_evaluation_before_mutation(self):
+        def kernel(a, b):
+            value = a + b
+            a[0] = 99
+            return value.sum()
+
+        @njit(inline='never')
+        def mutate(a):
+            a[0] = 99
+
+        def opaque_call(a, b):
+            value = a + b
+            mutate(a)
+            return value.sum()
+
+        a = np.arange(5)
+        for pyfunc in (kernel, opaque_call):
+            functions = self.compile(pyfunc)
+            expected = pyfunc(a.copy(), a.copy())
+            for compiled in functions:
+                self.assertPreciseEqual(
+                    compiled(a.copy(), a.copy()), expected)
+            self.assert_allocation(functions[0], False)
+
+    def test_unsupported_reductions(self):
+        def axis(a, b):
+            return (a + b).sum(axis=0)
+
+        def dtype(a, b):
+            return (a + b).sum(dtype=np.int32)
+
+        def plain(a, b):
+            return (a + b).sum()
+
+        a = np.arange(6)
+        cases = ((axis, a), (dtype, a), (plain, a.astype(np.float64)),
+                 (plain, a.reshape(2, 3)))
+        for kernel, a in cases:
+            with self.subTest(kernel=kernel.__name__, dtype=a.dtype,
+                              ndim=a.ndim):
+                functions = self.compile(kernel)
+                self.check(functions, a, a)
+                self.assert_allocation(functions[0], True)
+
+    def test_parallel_fallback(self):
+        @njit(parallel=True)
+        def kernel(a, b):
+            return (a + b).sum()
+
+        a = np.arange(100)
+        self.assertPreciseEqual(kernel(a, a), kernel.py_func(a, a))
+        result = kernel.overloads[kernel.signatures[0]]
+        self.assertNotIn('arrayexpr_sum', str(result.type_annotation))
+        self.assertEqual(result.metadata['parfor_diagnostics'].count_parfors(),
+                         1)
+
+
+if __name__ == '__main__':
+    unittest.main()
