++ dirname -- report.sh
+ cd -- .
+ python=/tmp/shap-bench-venv/bin/python
+ flamegraph=/tmp/FlameGraph
+ /tmp/shap-bench-venv/bin/python analyze.py
+ /tmp/FlameGraph/difffolded.pl original/per-call.folded optimized/per-call.folded
+ /tmp/FlameGraph/flamegraph.pl --title 'SHAP diff | estimated cycles per call | AFTER widths' --countname 'estimated cycles/call' diff-after.folded
+ /tmp/FlameGraph/difffolded.pl optimized/per-call.folded original/per-call.folded
+ /tmp/FlameGraph/flamegraph.pl --negate --title 'SHAP diff | estimated cycles per call | BEFORE widths' --countname 'estimated cycles/call' diff-before.folded
